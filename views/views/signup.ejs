<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | Ambulance Tracking System</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        :root {
            --primary-color: #b71c1c;
            --secondary-color: #d32f2f;
            --accent-color: #c62828;
            --light-color: #fff8f8;
            --text-color: #2c2c2c;
            --card-bg: #ffffff;
            --primary-blue: #d32f2f;
            --dark-blue: #b71c1c;
            --light-gray: #fef2f2;
            --medium-gray: #ddd;
            --dark-gray: #5e5e5e;
            --shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--light-gray);
            color: var(--text-color);
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        header {
            margin-bottom: 40px;
            text-align: center;
        }

        .project-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 10px;
        }

        .subject-title {
            font-size: 1.1rem;
            color: var(--accent-color);
            font-weight: 500;
            margin-bottom: 30px;
            display: inline-block;
            padding: 8px 20px;
            background-color: rgba(183, 28, 28, 0.1);
            border-radius: 20px;
        }

        .signup-container {
            background-color: white;
            border-radius: 12px;
            box-shadow: var(--shadow);
            padding: 40px;
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
        }

        .signup-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .signup-header h2 {
            color: var(--primary-color);
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        .signup-header p {
            color: var(--dark-gray);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--primary-color);
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid var(--medium-gray);
            border-radius: 8px;
            font-size: 1rem;
            transition: var(--transition);
        }

        .form-control:focus {
            border-color: var(--primary-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(183, 28, 28, 0.2);
        }

        .btn {
            display: inline-block;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
            border: none;
        }

        .btn-primary {
            background: var(--primary-blue);
            color: white;
            width: 100%;
        }

        .btn-primary:hover {
            background: var(--dark-blue);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        .login-link {
            text-align: center;
            margin-top: 20px;
            color: var(--dark-gray);
        }

        .login-link a {
            color: var(--primary-blue);
            text-decoration: none;
            font-weight: 500;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        .error-message {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 5px;
            display: none;
        }

        .success-message {
            color: #28a745;
            font-size: 0.85rem;
            margin-top: 5px;
            display: none;
        }

        .password-container {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--dark-gray);
        }

        .user-type-container {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .user-type-option {
            flex: 1;
            text-align: center;
        }

        .user-type-radio {
            display: none;
        }

        .user-type-label {
            display: block;
            padding: 15px;
            border: 2px solid var(--medium-gray);
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
        }

        .user-type-radio:checked + .user-type-label {
            border-color: var(--primary-color);
            background-color: rgba(183, 28, 28, 0.1);
        }

        .user-type-icon {
            font-size: 1.5rem;
            margin-bottom: 8px;
            color: var(--primary-color);
        }

        @media (max-width: 600px) {
            .signup-container {
                padding: 30px 20px;
            }

            .project-title {
                font-size: 1.8rem;
            }

            .user-type-container {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <header>
            <h1 class="project-title">Ambulance Tracking System</h1>
            <div class="subject-title">Project Based Learning DAA</div>
        </header>

        <div class="signup-container">
            <div class="signup-header">
                <h2>Create Your Account</h2>
                <p>Join us to access emergency services and tracking</p>
            </div>

            <form id="signupForm">
                <div class="user-type-container">
                    <div class="user-type-option">
                        <input type="radio" id="userTypeNormal" name="userType" value="user" class="user-type-radio" checked>
                        <label for="userTypeNormal" class="user-type-label">
                            <div class="user-type-icon"><i class="fas fa-user"></i></div>
                            <div>Normal User</div>
                        </label>
                    </div>
                    <div class="user-type-option">
                        <input type="radio" id="userTypeDriver" name="userType" value="driver" class="user-type-radio">
                        <label for="userTypeDriver" class="user-type-label">
                            <div class="user-type-icon"><i class="fas fa-ambulance"></i></div>
                            <div>Ambulance Driver</div>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" class="form-control" placeholder="Enter your full name" required>
                    <div class="error-message" id="name-error">Please enter your name</div>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" class="form-control" placeholder="Enter your email" required>
                    <div class="error-message" id="email-error">Please enter a valid email</div>
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" class="form-control" placeholder="Enter your phone number" required>
                    <div class="error-message" id="phone-error">Please enter a valid phone number</div>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <div class="password-container">
                        <input type="password" id="password" class="form-control" placeholder="Create a password"
                            required>
                        <i class="fas fa-eye password-toggle" id="togglePassword"></i>
                    </div>
                    <div class="error-message" id="password-error">Password must be at least 6 characters</div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="password-container">
                        <input type="password" id="confirmPassword" class="form-control"
                            placeholder="Confirm your password" required>
                        <i class="fas fa-eye password-toggle" id="toggleConfirmPassword"></i>
                    </div>
                    <div class="error-message" id="confirm-error">Passwords don't match</div>
                </div>

                <!-- Additional fields for drivers -->
                <div id="driverFields" style="display: none;">
                    <div class="form-group">
                        <label for="licenseNumber">Driver License Number</label>
                        <input type="text" id="licenseNumber" class="form-control" placeholder="Enter your license number">
                    </div>
                    <div class="form-group">
                        <label for="ambulanceNumber">Ambulance Number</label>
                        <input type="text" id="ambulanceNumber" class="form-control" placeholder="Enter ambulance number">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Sign Up</button>

                <div class="error-message" id="signup-error" style="text-align: center; margin-top: 15px;"></div>
                <div class="success-message" id="signup-success">Account created successfully! Redirecting...</div>
            </form>

            <div class="login-link">
                Already have an account? <a href="adminlogin.ejs">Log in</a>
            </div>
        </div>
    </div>

    <!-- Add Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.6.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.0/firebase-database-compat.js"></script>

    <script>
        // Firebase configuration (replace with your actual config)
        const firebaseConfig = {
            apiKey: "AIzaSyDZBTUa_MVYu57P-hvtWUFB4lby52iGoZE",
            authDomain: "absh-24bfb.firebaseapp.com",
            projectId: "absh-24bfb",
            storageBucket: "absh-24bfb.firebasestorage.app",
            messagingSenderId: "1010389232161",
            appId: "1:1010389232161:web:4d6edda99dd0bd378b5160",
            measurementId: "G-PE6D32YL6G"
        };

        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const auth = firebase.auth();
        const database = firebase.database();

        // Password toggle functionality
        const togglePassword = document.querySelector('#togglePassword');
        const toggleConfirmPassword = document.querySelector('#toggleConfirmPassword');
        const password = document.querySelector('#password');
        const confirmPassword = document.querySelector('#confirmPassword');

        togglePassword.addEventListener('click', function () {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.classList.toggle('fa-eye-slash');
        });

        toggleConfirmPassword.addEventListener('click', function () {
            const type = confirmPassword.getAttribute('type') === 'password' ? 'text' : 'password';
            confirmPassword.setAttribute('type', type);
            this.classList.toggle('fa-eye-slash');
        });

        // Show/hide driver fields based on user type selection
        const userTypeRadios = document.querySelectorAll('input[name="userType"]');
        const driverFields = document.getElementById('driverFields');

        userTypeRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.value === 'driver') {
                    driverFields.style.display = 'block';
                } else {
                    driverFields.style.display = 'none';
                }
            });
        });

        // Form validation and submission
        document.getElementById('signupForm').addEventListener('submit', function (e) {
            e.preventDefault();

            // Reset error messages
            document.querySelectorAll('.error-message').forEach(el => {
                el.style.display = 'none';
            });
            document.getElementById('signup-error').textContent = '';
            document.getElementById('signup-success').style.display = 'none';

            // Get values
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const userType = document.querySelector('input[name="userType"]:checked').value;
            
            // Driver specific fields
            let licenseNumber = '';
            let ambulanceNumber = '';
            
            if (userType === 'driver') {
                licenseNumber = document.getElementById('licenseNumber').value.trim();
                ambulanceNumber = document.getElementById('ambulanceNumber').value.trim();
            }

            // Validation
            let isValid = true;

            if (name === '') {
                document.getElementById('name-error').style.display = 'block';
                isValid = false;
            }

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                document.getElementById('email-error').style.display = 'block';
                isValid = false;
            }

            if (!/^[0-9]{10,15}$/.test(phone)) {
                document.getElementById('phone-error').style.display = 'block';
                isValid = false;
            }

            if (password.length < 6) {
                document.getElementById('password-error').style.display = 'block';
                isValid = false;
            }

            if (password !== confirmPassword) {
                document.getElementById('confirm-error').style.display = 'block';
                isValid = false;
            }

            // Additional validation for drivers
            if (userType === 'driver') {
                if (licenseNumber === '') {
                    alert('Please enter your driver license number');
                    isValid = false;
                }
                if (ambulanceNumber === '') {
                    alert('Please enter your ambulance number');
                    isValid = false;
                }
            }

            if (!isValid) return;

            // Create user with Firebase Auth
            auth.createUserWithEmailAndPassword(email, password)
                .then((userCredential) => {
                    // Signed in 
                    const user = userCredential.user;

                    // Prepare user data
                    const userData = {
                        name: name,
                        email: email,
                        phone: phone,
                        userType: userType,
                        createdAt: firebase.database.ServerValue.TIMESTAMP
                    };

                    // Add driver-specific data if applicable
                    if (userType === 'driver') {
                        userData.licenseNumber = licenseNumber;
                        userData.ambulanceNumber = ambulanceNumber;
                        userData.status = 'available'; // Default status for drivers
                    }

                    // Save user data to Realtime Database
                    return database.ref('users/' + user.uid).set(userData);
                })
                .then(() => {
                    // Show success message
                    document.getElementById('signup-success').style.display = 'block';

                    // Redirect after 2 seconds
                    setTimeout(() => {
                        // Redirect based on user type
                        if (userType === 'driver') {
                            window.location.href = 'driver-dashboard.html';
                        } else {
                            window.location.href = 'user-dashboard.html';
                        }
                    }, 2000);
                })
                .catch((error) => {
                    const errorCode = error.code;
                    const errorMessage = error.message;

                    // Show error message
                    const errorElement = document.getElementById('signup-error');
                    errorElement.textContent = errorMessage;
                    errorElement.style.display = 'block';

                    // Specific error handling
                    if (errorCode === 'auth/email-already-in-use') {
                        errorElement.textContent = 'This email is already registered. Please log in.';
                    } else if (errorCode === 'auth/weak-password') {
                        errorElement.textContent = 'Password should be at least 6 characters';
                    }
                });
        });
    </script>
</body>

</html>